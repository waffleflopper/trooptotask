# --- Supabase (required) ---------------------------------------------------
# Local development: run `supabase start`, then `supabase status -o env`
# to print these values. See README "Getting Started".
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# --- App origins (optional for local development) --------------------------
# Primary public origin used for generated links; production requires one
# official origin value.
# APP_PUBLIC_ORIGIN=https://app.example.com
# Fallback public origin accepted by the origin resolver.
# PUBLIC_APP_ORIGIN=https://app.example.com
# Fallback public site origin accepted by the origin resolver.
# PUBLIC_SITE_URL=https://app.example.com
# Comma-separated extra origins allowed for preview or callback flows.
# APP_PUBLIC_ORIGIN_ALLOWLIST=https://preview.example.com

# --- Billing (optional - app runs without it) -------------------------------
# Enables paid billing UI and billing-specific flows.
# PUBLIC_BILLING_ENABLED=false
# Stripe API secret used by server-side billing operations.
# STRIPE_SECRET_KEY=replace_with_stripe_secret_key
# Stripe webhook signing secret used by the webhook endpoint.
# STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
# Active Stripe recurring price for team plans.
# STRIPE_TEAM_PRICE_ID=replace_with_team_price_id
# Active Stripe recurring price for unit plans.
# STRIPE_UNIT_PRICE_ID=replace_with_unit_price_id
# Comma-separated legacy team price IDs accepted during reconciliation.
# STRIPE_TEAM_LEGACY_PRICE_IDS=replace_with_legacy_team_price_ids
# Comma-separated legacy unit price IDs accepted during reconciliation.
# STRIPE_UNIT_LEGACY_PRICE_IDS=replace_with_legacy_unit_price_ids
# Enables Stripe automatic tax after dashboard setup is verified.
# STRIPE_AUTOMATIC_TAX_ENABLED=false
# Confirms Stripe Tax dashboard configuration has been reviewed.
# STRIPE_TAX_DASHBOARD_VERIFIED=false

# --- Billing operations and backfill scripts (optional) ---------------------
# Bearer secret accepted by the billing reconciliation endpoint.
# BILLING_RECONCILIATION_SECRET=replace_with_reconciliation_secret
# App URL used by the billing snapshot backfill script.
# BACKFILL_APP_URL=http://localhost:5173
# Fallback app URL used by the billing snapshot backfill script.
# PUBLIC_APP_URL=http://localhost:5173
# Fallback bearer secret used by the billing snapshot backfill script.
# BACKFILL_SECRET=replace_with_backfill_secret

# --- Email delivery (optional - app runs without it) ------------------------
# Resend API key for invitation and account setup email delivery.
# RESEND_API_KEY=replace_with_resend_api_key
# Sender address for Resend and local Mailpit delivery.
# RESEND_FROM_EMAIL=noreply@example.test
# Local Mailpit API URL used when E2E email delivery is enabled.
# MAILPIT_URL=http://127.0.0.1:54324

# --- Account setup and scheduled jobs (optional) ----------------------------
# Production secret used to sign account setup sessions.
# ACCOUNT_SETUP_SESSION_SECRET=replace_with_account_setup_session_secret
# Bearer secret accepted by cleanup endpoints.
# CLEANUP_SECRET=replace_with_cleanup_secret
# Shared bearer secret accepted by scheduled job endpoints.
# CRON_SECRET=replace_with_cron_secret

# --- Feedback integration (optional) ----------------------------------------
# GitHub token used by the feedback endpoint to create issues.
# GITHUB_FEEDBACK_TOKEN=replace_with_github_feedback_token

# --- Local test helpers (optional) ------------------------------------------
# Skips rate limiting and routes test emails to Mailpit in local E2E runs.
# E2E_TESTING=false
