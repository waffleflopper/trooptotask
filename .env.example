# Required Supabase settings for local development.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public app URLs used for links and origin validation.
APP_PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
APP_PUBLIC_ORIGIN_ALLOWLIST=http://127.0.0.1:4173

# Optional billing feature flag.
PUBLIC_BILLING_ENABLED=false

# Optional Stripe billing settings.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_TEAM_PRICE_ID=price_team_xxx
STRIPE_UNIT_PRICE_ID=price_unit_xxx
STRIPE_TEAM_LEGACY_PRICE_IDS=
STRIPE_UNIT_LEGACY_PRICE_IDS=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_DASHBOARD_VERIFIED=false

# Optional billing reconciliation and backfill authorization.
BILLING_RECONCILIATION_SECRET=billing-secret
BACKFILL_SECRET=backfill-secret
BACKFILL_APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Optional email delivery settings.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@example.test
MAILPIT_URL=http://127.0.0.1:54324

# Optional account setup and scheduled cleanup settings.
ACCOUNT_SETUP_SESSION_SECRET=setup-secret
CLEANUP_SECRET=cleanup-secret
CRON_SECRET=cron-secret

# Optional local test helper.
E2E_TESTING=false
