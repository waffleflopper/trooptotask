{
	"git": {
		"deploymentEnabled": {
			"t3code/agent-verification-toolkit": false,
			"stabilization/08-d04-calendar-pilot": false
		}
	},
	"installCommand": "npx npm@11.12.1 ci",
	"buildCommand": "npm run build",
	"rewrites": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "admin.trooptotask.org" }],
			"destination": "/admin/:path*"
		}
	],
	"crons": [
		{
			"path": "/api/cleanup-old-data",
			"schedule": "0 4 * * 0"
		},
		{
			"path": "/api/cleanup-archived-records",
			"schedule": "0 5 * * *"
		},
		{
			"path": "/api/cleanup-expired-onboardings",
			"schedule": "0 6 * * *"
		},
		{
			"path": "/api/cleanup-account-setup-links",
			"schedule": "0 7 * * *"
		}
	]
}
