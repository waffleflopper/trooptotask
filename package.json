{
	"name": "trooptotask",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.12.1",
	"engines": {
		"node": "24.x",
		"npm": "11.12.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"governance:check": "node ./scripts/check-governance.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:auth": "playwright test --config=e2e/playwright.config.ts e2e/specs/auth-email-flows.spec.ts",
		"test:e2e:access-requests": "playwright test --config=e2e/playwright.config.ts e2e/specs/access-request-auth.spec.ts",
		"test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
		"test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"sandcastle": "npx tsx .sandcastle/main.mts"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "^0.5.6",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^3.2.0",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"dotenv": "^17.3.1",
		"eslint": "^9.39.4",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"happy-dom": "^20.9.0",
		"jsdom": "^29.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"typescript": "^5.3.0",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.0.10",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/barlow-condensed": "^5.2.8",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/source-serif-4": "^5.2.9",
		"@lucide/svelte": "^1.3.0",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.94.1",
		"@sveltejs/adapter-vercel": "^6.3.2",
		"@vercel/analytics": "^1.6.1",
		"@vercel/speed-insights": "^2.0.0",
		"exceljs": "^4.4.0",
		"headroom-ai": "^0.1.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.7",
		"layerchart": "^1.0.13",
		"resend": "^6.9.3",
		"stripe": "^22.1.0",
		"svelte-dnd-action": "^0.9.69",
		"xlsx": "^0.18.5",
		"zod": "^4.3.6"
	}
}
