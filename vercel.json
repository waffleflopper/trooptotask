{
	"git": {
		"deploymentEnabled": {
			"main": true,
			"**": false
		}
	},
	"installCommand": "npx npm@11.12.1 ci",
	"ignoreCommand": "sha=$VERCEL_GIT_PREVIOUS_SHA; [ \"$sha\" != \"$(git rev-parse HEAD)\" ] && git diff --quiet --no-renames \"$sha\" HEAD -- . ':!docs/*.md' ':!.agents/*.md' ':!README.md' ':!AGENTS.md' ':!CLAUDE.md' ':!CONTEXT.md' ':!src/*.test.ts' ':!scripts/*.test.*' || exit 1",
	"buildCommand": "npm run build",
	"regions": ["pdx1"],
	"rewrites": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "admin.trooptotask.org"
				}
			],
			"destination": "/admin/:path*"
		}
	],
	"crons": [
		{
			"path": "/api/cleanup-old-data",
			"schedule": "0 4 * * 0"
		},
		{
			"path": "/api/cleanup-archived-records",
			"schedule": "0 5 * * *"
		},
		{
			"path": "/api/cleanup-expired-onboardings",
			"schedule": "0 6 * * *"
		},
		{
			"path": "/api/cleanup-account-setup-links",
			"schedule": "0 7 * * *"
		}
	]
}
